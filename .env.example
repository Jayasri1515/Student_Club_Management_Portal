# Copy to `.env.local` (git-ignored) for local overrides, or set the variable in
# your hosting provider's build environment. Vite reads it at BUILD time.
#
# Base URL of the Spring Boot backend, including the `/api` prefix.
# Trailing slashes are removed automatically.
# If unset/blank the app falls back to http://localhost:8082/api
VITE_API_BASE_URL=http://localhost:8082/api
